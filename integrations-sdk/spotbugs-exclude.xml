<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude EI_EXPOSE_REP and EI_EXPOSE_REP2 for SDK service classes -->
    <!-- These POJOs and service classes are designed to expose their internal state -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2,MS_EXPOSE_REP" />
    </Match>

    <!-- Exclude CT_CONSTRUCTOR_THROW for service implementations -->
    <!-- Service constructors may throw exceptions during initialization which is acceptable -->
    <Match>
        <Bug pattern="CT_CONSTRUCTOR_THROW" />
    </Match>

    <!-- Exclude REFLC_REFLECTION_MAY_INCREASE_ACCESSIBILITY_OF_CLASS -->
    <!-- Reflection is intentionally used in factory methods and plugin loaders -->
    <Match>
        <Bug pattern="REFLC_REFLECTION_MAY_INCREASE_ACCESSIBILITY_OF_CLASS" />
    </Match>

    <!-- Exclude SS_SHOULD_BE_STATIC for constant fields -->
    <Match>
        <Bug pattern="SS_SHOULD_BE_STATIC" />
    </Match>

    <!-- New detectors introduced by SpotBugs 4.9.x analyzer upgrade (pre-existing latent findings) -->
    <Match>
        <Bug pattern="AT_STALE_THREAD_WRITE_OF_PRIMITIVE,NN_NAKED_NOTIFY,FS_BAD_DATE_FORMAT_FLAG_COMBO,AT_NONATOMIC_64BIT_PRIMITIVE" />
    </Match>
</FindBugsFilter>

